{
  "expo": {
    "name": "Evolve",
    "slug": "evolve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "evolve",
    "userInterfaceStyle": "dark",
    "ios": {
      "userInterfaceStyle": "dark",
      "icon": "./assets/logo.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.gabriel.evolve",
      "appleTeamId": "DYT84KCFF7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "O Evolve lê seu sono e sua frequência cardíaca do app Saúde para transformar suas noites em progresso do personagem. Nada é escrito de volta e nada sai do seu aparelho sem a sua conta.",
        "NSCameraUsageDescription": "O Evolve usa a câmera para fotografar a página do seu diário e o prato da refeição. As fotos ficam na sua conta.",
        "NSPhotoLibraryUsageDescription": "O Evolve acessa suas fotos para você escolher uma imagem já tirada do diário ou da refeição, em vez de fotografar de novo.",
        "NSMicrophoneUsageDescription": "O Evolve grava áudio para você ditar o diário e o que comeu, em vez de digitar. A gravação fica na sua conta e a transcrição é feita a seu pedido."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "userInterfaceStyle": "dark",
      "package": "com.gabriel.evolve",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1115",
          "android": {
            "image": "./assets/logo.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#A855F7"
        }
      ],
      [
        "react-native-device-activity",
        {
          "appGroup": "group.com.gabriel.evolve",
          "appleTeamId": "DYT84KCFF7",
          "copyToTargetFolder": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.gabriel.evolve.widgets",
          "groupIdentifier": "group.com.gabriel.evolve",
          "widgets": [
            {
              "name": "TodayJourneyWidget",
              "displayName": "Jornada de Hoje",
              "description": "Ações, metas e estado do personagem para manter a campanha do dia viva.",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ]
            }
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Evolve grava áudio para você ditar o diário e o que comeu, em vez de digitar. A gravação fica na sua conta e a transcrição é feita a seu pedido."
        }
      ],
      "@kingstinct/react-native-healthkit",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91d600d6-cc8c-43a2-ac83-8c25e4b677c7"
      }
    }
  }
}
