{
  "expo": {
    "name": "Evolve",
    "slug": "evolve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "evolve",
    "userInterfaceStyle": "dark",
    "ios": {
      "userInterfaceStyle": "dark",
      "icon": "./assets/logo.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.gabriel.evolve",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "userInterfaceStyle": "dark",
      "package": "com.gabriel.evolve",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1115",
          "android": {
            "image": "./assets/logo.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#A855F7"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.gabriel.evolve.widgets",
          "groupIdentifier": "group.com.gabriel.evolve",
          "widgets": [
            {
              "name": "TodayJourneyWidget",
              "displayName": "Jornada de Hoje",
              "description": "Ações, metas e estado do personagem para manter a campanha do dia viva.",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91d600d6-cc8c-43a2-ac83-8c25e4b677c7"
      }
    }
  }
}
