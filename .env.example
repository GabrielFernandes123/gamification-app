# Copie para .env e preencha com os valores do seu projeto Supabase (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_publishable
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001/v1

# Opcional: usado por npm run seed:demo
SUPABASE_SEED_EMAIL=seu_email_de_login
SUPABASE_SEED_PASSWORD=sua_senha
